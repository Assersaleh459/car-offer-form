# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Password for /admin. At least 12 characters, or admin login stays disabled.
ADMIN_PASSWORD=

# AuctionsAPI demo key. Leave empty to use mock comparable sales.
AUCTIONS_API_KEY=

# Neon Postgres connection string (postgresql://...). Leave empty locally to save
# leads to data/leads.json instead. Required on Vercel.
DATABASE_URL=
